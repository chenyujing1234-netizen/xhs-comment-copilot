{
  "manifest_version": 3,
  "name": "小红书评论获客助手",
  "version": "1.0.1",
  "description": "通过在小红书相关视频下发布拟人化评论，引导潜在客户主动联系你了解产品。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "https://token-plan.cn-beijing.maas.aliyuncs.com/*",
    "https://dysmsapi.aliyuncs.com/*",
    "https://api.openai.com/*",
    "https://linkpal.cloud/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "小红书评论获客助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.xiaohongshu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
